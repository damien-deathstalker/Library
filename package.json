{
  "name": "bookshelf",
  "version": "1.0.0",
  "private": true,
  "description": "Damien Ofei's bookshelf — speculative fiction, published a chapter at a time.",
  "scripts": {
    "build": "postcss src/css/app.css -o shelf/static/shelf/css/app.css --minify",
    "dev": "postcss src/css/app.css -o shelf/static/shelf/css/app.css --watch --minify",
    "expand": "postcss src/css/app.css -o shelf/static/shelf/css/app.css"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0"
  }
}